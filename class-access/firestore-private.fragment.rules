// Merge inside match /databases/{database}/documents; replace the OLD member match.
// Do not deploy this fragment as a complete rules file.
// Overlapping broad allow rules must exclude all three paths below.
match /artmind2_class_access/{classId} {
 allow read, write: if false;
}
match /artmind2_class_public/{classId} {
 allow get: if request.auth != null;
 allow list, write: if false;
}
match /artmind2_members/{uid} {
 function self() { return request.auth != null && request.auth.uid == uid; }
 function validEntry() {
  let d = request.resource.data;
  let c = get(/databases/$(database)/documents/artmind2_class_access/$(d.classId)).data;
  return d.keys().hasAll(['classId','nickname','passwordProof','joinedAt'])
   && d.keys().hasOnly(['classId','nickname','passwordProof','joinedAt'])
   && d.classId is string && d.classId.matches('[1-3]-([1-9]|1[0-9]|20)')
   && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20
   && d.passwordProof is string && d.passwordProof.matches('[a-f0-9]{64}')
   && d.joinedAt == request.time && c.enabled == true && d.passwordProof == c.passwordHash;
 }
 allow get: if self();
 allow list: if false;
 allow create: if self() && validEntry();
 // Only removal of the temporary proof is permitted. Class/name cannot be edited.
 allow update: if self()
  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordProof'])
  && !('passwordProof' in request.resource.data);
 allow delete: if false;
}
