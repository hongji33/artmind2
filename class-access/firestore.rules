rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부
    function signedIn() {
      return request.auth != null;
    }

    // 교사가 승인한 학생인지 확인
    function member() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/artmind2_members/$(request.auth.uid)
        );
    }

    // 승인된 학생의 학급
    function myClass() {
      return get(
        /databases/$(database)/documents/artmind2_members/$(request.auth.uid)
      ).data.classId;
    }

    // 전시 문서 경로
    function exhibitPath(exhibitId) {
      return /databases/$(database)/documents/artmind2_exhibits/$(exhibitId);
    }

    // 해당 전시가 나와 같은 반인지 확인
    function sameClass(exhibitId) {
      return member()
        && exists(exhibitPath(exhibitId))
        && get(exhibitPath(exhibitId)).data.classId == myClass();
    }

    // 전시 데이터 형식 검사
    function validExhibit() {
      return request.resource.data.keys().hasOnly([
          'owner',
          'classId',
          'grade',
          'classroom',
          'nickname',
          'title',
          'story',
          'work',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'owner',
          'classId',
          'nickname',
          'title',
          'story',
          'work'
        ])
        && request.resource.data.owner is string
        && request.resource.data.classId is string
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 30
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.story is string
        && request.resource.data.story.size() <= 3000
        && request.resource.data.work is map;
    }

    // 반 비밀번호로 검증한 학생 입장 정보
    match /artmind2_class_access/{classId} {
     allow read, write: if false;
    }
    match /artmind2_class_public/{classId} {
     allow get: if request.auth != null;
     allow list, write: if false;
    }
    match /artmind2_members/{uid} {
     function self() { return request.auth != null && request.auth.uid == uid; }
     function validEntry() {
      let d = request.resource.data;
      let c = get(/databases/$(database)/documents/artmind2_class_access/$(d.classId)).data;
      return d.keys().hasAll(['classId','nickname','passwordProof','joinedAt'])
       && d.keys().hasOnly(['classId','nickname','passwordProof','joinedAt'])
       && d.classId is string && d.classId.matches('[1-3]-([1-9]|1[0-9]|20)')
       && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20
       && d.passwordProof is string && d.passwordProof.matches('[a-f0-9]{64}')
       && d.joinedAt == request.time && c.enabled == true && d.passwordProof == c.passwordHash;
     }
     allow get: if self();
     allow list: if false;
     allow create: if self() && validEntry();
     // Only removal of the temporary proof is permitted. Class/name cannot be edited.
     allow update: if self()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordProof'])
      && !('passwordProof' in request.resource.data);
     allow delete: if false;
    }

    // 학생 작품 전시
    match /artmind2_exhibits/{exhibitId} {

      // 같은 반 전시만 열람
      allow get, list: if member()
        && resource.data.classId == myClass();

      // 자신의 전시만 새로 만들기
      allow create: if member()
        && request.auth.uid == exhibitId
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.classId == myClass()
        && validExhibit();

      // 자신의 전시만 수정
      // 작성자와 학급은 변경 불가
      allow update: if member()
        && request.auth.uid == exhibitId
        && resource.data.owner == request.auth.uid
        && resource.data.classId == myClass()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.classId == resource.data.classId
        && validExhibit();

      // 학생이 전시를 삭제하는 것은 제한
      allow delete: if false;

      // 친구의 응원 댓글
      match /comments/{commentId} {

        allow get, list: if sameClass(exhibitId);

        allow create: if sameClass(exhibitId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'classId',
            'nickname',
            'text',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid',
            'classId',
            'nickname',
            'text'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.classId == myClass()
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }

      // 친구 작품 좋아요
      match /likes/{uid} {

        allow get, list: if sameClass(exhibitId);

        // 한 학생당 전시별 좋아요 하나
        allow create: if sameClass(exhibitId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid',
            'classId',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid',
            'classId'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.classId == myClass();

        allow update, delete: if false;
      }
    }
  }
}
