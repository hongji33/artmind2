{
 "rules": {
  ".read": false,
  ".write": false,
  "museum_classes": {
   "$host": {
    "$class": {
     ".write": "auth != null && auth.uid == $host && auth.token.firebase.sign_in_provider == 'password' && $class.matches(/^[1-3]-([1-9]|1[0-9]|20)$/)",
     ".validate": "newData.hasChildren(['salt','iterations','passwordHash','enabled'])",
     "salt": {
      ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
     },
     "iterations": {
      ".validate": "newData.val() == 210000"
     },
     "passwordHash": {
      ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
     },
     "enabled": {
      ".validate": "newData.isBoolean()"
     },
     "$other": {
      ".validate": false
     }
    }
   }
  },
  "museum_members": {
   "$host": {
    "$uid": {
     ".read": "auth != null && auth.uid == $uid",
     ".write": "auth != null && auth.uid == $uid && (!newData.exists() || (newData.child('classId').isString() && root.child('museum_classes').child($host).child(newData.child('classId').val()).child('enabled').val() == true && newData.child('passwordProof').val() == root.child('museum_classes').child($host).child(newData.child('classId').val()).child('passwordHash').val() && (!data.exists() || (newData.child('classId').val() == data.child('classId').val() && newData.child('nickname').val() == data.child('nickname').val()))) || (data.exists() && newData.child('classId').val() == data.child('classId').val() && newData.child('nickname').val() == data.child('nickname').val() && newData.child('joinedAt').val() == data.child('joinedAt').val()))",
     ".validate": "newData.hasChildren(['classId','nickname','joinedAt'])",
     "classId": {
      ".validate": "newData.isString() && newData.val().matches(/^[1-3]-([1-9]|1[0-9]|20)$/)"
     },
     "nickname": {
      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
     },
     "joinedAt": {
      ".validate": "newData.isNumber() && (newData.val() == data.val() || (newData.val() >= now - 5000 && newData.val() <= now + 1000))"
     },
     "passwordProof": {
      ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
     },
     "$other": {
      ".validate": false
     }
    }
   }
  },
  "museum_presence": {
   "$host": {
    "$class": {
     ".read": "auth != null && ((auth.uid == $host && auth.token.firebase.sign_in_provider == 'password') || (root.child('museum_members').child($host).child(auth.uid).child('classId').val() == $class && root.child('museum_members').child($host).child(auth.uid).child('joinedAt').val() > now - 43200000))",
     "$uid": {
      "$session": {
       ".write": "auth != null && auth.uid == $uid && (!newData.exists() || (root.child('museum_members').child($host).child($uid).child('classId').val() == $class && root.child('museum_members').child($host).child($uid).child('joinedAt').val() > now - 43200000))",
       ".validate": "newData.hasChildren(['nickname','x','y','roomId','page','facing','back','seated','walking','appearance','lastSeen','speechCode','speechAt']) && newData.child('nickname').val() == root.child('museum_members').child($host).child($uid).child('nickname').val() && ((!data.exists() && newData.child('speechCode').val() == 0 && newData.child('speechAt').val() == 0) || (newData.child('speechCode').val() == data.child('speechCode').val() && newData.child('speechAt').val() == data.child('speechAt').val()) || (newData.child('speechCode').val() > 0 && newData.child('speechAt').val() >= now - 3000 && newData.child('speechAt').val() <= now + 1000 && data.child('speechAt').val() <= now - 4000))",
       "nickname": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
       },
       "x": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 28"
       },
       "y": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 22"
       },
       "roomId": {
        ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 3"
       },
       "page": {
        ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 5"
       },
       "facing": {
        ".validate": "newData.val() == 1 || newData.val() == -1"
       },
       "back": {
        ".validate": "newData.isBoolean()"
       },
       "seated": {
        ".validate": "newData.isBoolean()"
       },
       "walking": {
        ".validate": "newData.isBoolean()"
       },
       "lastSeen": {
        ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 1000"
       },
       "speechCode": {
        ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 4"
       },
       "speechAt": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
       },
       "appearance": {
        ".validate": "newData.hasChildren(['hair','outfit','skin','hairColor','color','expression'])",
        "hair": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 5"
        },
        "outfit": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 4"
        },
        "skin": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 3"
        },
        "hairColor": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 3"
        },
        "color": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 5"
        },
        "expression": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 5"
        },
        "$other": {
         ".validate": false
        }
       },
       "$other": {
        ".validate": false
       },
       "visual": {
        ".validate": "newData.hasChildren(['fabric','avatar','fabricScale'])",
        "fabric": {
         ".validate": "newData.isString() && newData.val().length <= 24000 && (newData.val() == '' || newData.val().matches(/^data:image\\/(png|webp);base64,[A-Za-z0-9+\\/=]+$/))"
        },
        "avatar": {
         ".validate": "newData.isString() && newData.val().length <= 50000 && (newData.val() == '' || newData.val().matches(/^data:image\\/(png|webp);base64,[A-Za-z0-9+\\/=]+$/))"
        },
        "fabricScale": {
         ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 12 && newData.val() <= 48"
        },
        "$other": {
         ".validate": false
        }
       }
      }
     }
    }
   }
  },
  "museum_layouts": {
   "$host": {
    "$class": {
     ".read": "auth != null && ((auth.uid == $host && auth.token.firebase.sign_in_provider == 'password') || (root.child('museum_members').child($host).child(auth.uid).child('classId').val() == $class && root.child('museum_members').child($host).child(auth.uid).child('joinedAt').val() > now - 43200000))",
     ".write": "auth != null && auth.uid == $host && auth.token.firebase.sign_in_provider == 'password' && $class.matches(/^[1-3]-([1-9]|1[0-9]|20)$/)",
     ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 't' || newData.val() == 'u' || newData.val() == 'partitions')"
    }
   }
  }
 }
}
